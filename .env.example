# 複製成 .env 後修改（.env 已在 .gitignore，不會被提交進 git）
#
# 用這兩條指令產生高強度隨機密鑰：
#   openssl rand -hex 32

# Agent 上報用的密鑰，要跟每台 Agent 的 REPORT_SECRET 一致
REPORT_SECRET=change-me-report-secret

# 管理後台密碼
ADMIN_SECRET=change-me-admin-secret

# 對外綁定的位址與端口。預設只綁本機，避免整台机器公網暴露；
# 想用 Tailscale 存取就填你的 Tailscale IP，例如 100.64.0.1；
# 想直接對公網開放（不建議，除非前面有反向代理 + HTTPS）就填 0.0.0.0
BIND_ADDR=127.0.0.1
PORT=8080

# 從哪個 GitHub Container Registry 帳號拉映像
# （對應 .github/workflows 建出來的 ghcr.io/<OWNER>/vps-monitor-server / -agent）
GHCR_OWNER=qzqmn
