# 複製成 .env 後修改（.env 已在 .gitignore，不會被提交進 git）
#
# 管理員帳號密碼、每台機器的上報密鑰，這些都不再是環境變數了——
# 第一次打開 http://中央端IP:8080/admin.html 會請你直接在網頁上建立
# 管理員帳號；新機器則是登入後台後在「新增機器」那裡登記，各自拿到
# 專屬密鑰，不用手動改這個檔案。

# 對外綁定的位址與端口。預設只綁本機，避免整台机器公網暴露；
# 想用 Tailscale 存取就填你的 Tailscale IP，例如 100.64.0.1；
# 想直接對公網開放（不建議，除非前面有反向代理 + HTTPS）就填 0.0.0.0
BIND_ADDR=127.0.0.1
PORT=8080

# 從哪個 GitHub Container Registry 帳號拉映像
# （對應 .github/workflows 建出來的 ghcr.io/<OWNER>/vps-monitor-server / -agent）
GHCR_OWNER=qzqmn

# 只有真的在前面架了 HTTPS 反向代理才打開，讓登入用的 Cookie 加上 Secure
# 屬性（純 HTTP／Tailscale 內網存取請保持 false，否則瀏覽器會直接
# 拒絕送出這顆 Cookie，永遠登不進後台）。
COOKIE_SECURE=false
