# 複製成 .env 後修改（.env 已在 .gitignore，不會被提交進 git）

# 中央端網址
MONITOR_URL=http://中央端IP:8080

# 這台機器的 id，要先在中央端後台「新增機器」登記過，不然上報會被拒絕
AGENT_ID=change-me-agent-id

# 登記時後台顯示的專屬密鑰，複製貼過來（不是自己隨便取的字串，
# 也不是所有機器共用同一組——每台都不一樣）
REPORT_SECRET=change-me-to-the-token-shown-in-admin-panel

# 可選
INTERVAL_SECS=20
AGENT_NAME=
NET_IFACES=
